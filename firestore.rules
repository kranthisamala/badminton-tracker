rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }
    function isOwner() { return request.auth != null && role() == 'owner'; }
    function canEdit() { return request.auth != null && (role() == 'editor' || role() == 'owner'); }

    match /trackerData/{docId} {
      allow read: if request.auth != null;
      // Editors/owner can write anything. Everyone else (players) may only
      // opt themselves in/out of an in-progress session, which touches
      // nothing but the attendance map — sessions, members, dues, and
      // everything else stay untouched. This is what lets a player self-serve
      // attendance (see TrackerStoreService.optInSession/optOutSession)
      // without granting edit rights over costs or payments.
      allow write: if canEdit()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance']));
    }

    match /auditLog/{entryId} {
      allow read: if request.auth != null;
      allow create: if canEdit();
      allow update, delete: if false;
    }

    // username -> {memberId, uid} lookup used by the login screen before the
    // user is authenticated. Contains no secrets. Only ever written by the
    // Admin SDK provisioning script (bypasses rules entirely), never by the
    // client app.
    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    // Accounts are provisioned only via scripts/provision-member-accounts.js
    // (Admin SDK, bypasses these rules). From the client:
    //  - a signed-in user can read their OWN doc; only the owner can read
    //    anyone else's or list the collection. Listing is what the Access tab
    //    does, and it is owner-only; the Activity Log does not need this
    //    collection because each entry stores its author's username inline.
    //    Keeping list owner-only is what actually hides the test accounts
    //    created by scripts/provision-test-accounts.js from everyone else.
    //  - the owner can change anyone's `role` (promote/demote)
    //  - a signed-in user can update their OWN doc, but only to clear
    //    mustChangePassword / set contactEmail after first login — never to
    //    change their own role, username, or memberId
    match /roles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create, delete: if false;
      allow update: if isOwner()
        || (request.auth != null
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.username == resource.data.username
            && request.resource.data.memberId == resource.data.memberId);
    }
  }
}
